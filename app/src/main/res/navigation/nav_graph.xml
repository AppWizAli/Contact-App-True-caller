<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_phone">

    <fragment
        android:id="@+id/nav_phone"
        android:name="com.amna.dailler.DialerFragment"
        android:label="Phone"
        tools:layout="@layout/fragment_dialer" />

    <fragment
        android:id="@+id/nav_contacts"
        android:name="com.amna.dailler.ContactsFragment"
        android:label="Contacts"
        tools:layout="@layout/fragment_contacts" />

    <fragment
        android:id="@+id/nav_groups"
        android:name="com.amna.dailler.GroupsFragment"
        android:label="Groups"
        tools:layout="@layout/fragment_groups" />

    <fragment
        android:id="@+id/nav_dialpad"
        android:name="com.amna.dailler.DialpadFragment"
        android:label="Dialpad"
        tools:layout="@layout/fragment_dialpad" />

    <fragment
        android:id="@+id/nav_contact_detail"
        android:name="com.amna.dailler.ContactDetailFragment"
        android:label="Contact Detail"
        tools:layout="@layout/fragment_contact_detail">
        <argument
            android:name="contactName"
            app:argType="string" />
        <argument
            android:name="contactNumber"
            app:argType="string" />
        <argument
            android:name="contactId"
            app:argType="string"
            android:defaultValue="-1" />
    </fragment>

    <fragment
        android:id="@+id/nav_history_detail"
        android:name="com.amna.dailler.HistoryDetailFragment"
        android:label="History Detail"
        tools:layout="@layout/fragment_history_detail" />

    <fragment
        android:id="@+id/nav_create_contact"
        android:name="com.amna.dailler.CreateContactFragment"
        android:label="Create Contact"
        tools:layout="@layout/fragment_create_contact" />

    <fragment
        android:id="@+id/nav_contacts_to_display"
        android:name="com.amna.dailler.ContactsToDisplayFragment"
        android:label="Contacts to Display"
        tools:layout="@layout/fragment_contacts_to_display" />

    <fragment
        android:id="@+id/nav_delete_contacts"
        android:name="com.amna.dailler.DeleteContactsFragment"
        android:label="Delete Contacts"
        tools:layout="@layout/fragment_delete_contacts" />

    <fragment
        android:id="@+id/nav_account"
        android:name="com.amna.dailler.AccountFragment"
        android:label="Account"
        tools:layout="@layout/fragment_account" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.amna.dailler.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/nav_settings_appearance"
        android:name="com.amna.dailler.AppearanceSettingsFragment"
        android:label="Appearance"
        tools:layout="@layout/fragment_settings_appearance" />

    <fragment
        android:id="@+id/nav_settings_dialpad"
        android:name="com.amna.dailler.DialpadSettingsFragment"
        android:label="Dialpad"
        tools:layout="@layout/fragment_settings_dialpad" />

    <fragment
        android:id="@+id/nav_settings_contacts"
        android:name="com.amna.dailler.ContactsSettingsFragment"
        android:label="Contacts"
        tools:layout="@layout/fragment_settings_contacts" />
</navigation>
