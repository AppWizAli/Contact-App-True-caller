<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_light_bg"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Section: Create Contact & Display -->
    <LinearLayout
        android:id="@+id/layout_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/btn_create_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_contacts_24"
                app:tint="@color/primary_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Create new contact"
                android:textColor="@color/primary_blue"
                android:textSize="16sp" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/display_container"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/tv_entered_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary_light"
                android:textSize="32sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="0306 5040150" />

            <ImageView
                android:id="@+id/iv_backspace"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_backspace"
                app:tint="@color/text_secondary_light"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/tv_entered_number"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_entered_number" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- Keypad Section using Chains -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/keypad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/actions_layout">

        <include layout="@layout/view_keypad_button" android:id="@+id/btn_1"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/btn_2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include layout="@layout/view_keypad_button" android:id="@+id/btn_2"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/btn_3"
            app:layout_constraintStart_toEndOf="@+id/btn_1"
            app:layout_constraintTop_toTopOf="parent" />

        <include layout="@layout/view_keypad_button" android:id="@+id/btn_3"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_2"
            app:layout_constraintTop_toTopOf="parent" />

        <include layout="@layout/view_keypad_button" android:id="@+id/btn_4"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/btn_5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_1" />

        <include layout="@layout/view_keypad_button" android:id="@+id/btn_5"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/btn_6"
            app:layout_constraintStart_toEndOf="@+id/btn_4"
            app:layout_constraintTop_toBottomOf="@+id/btn_2" />

        <include layout="@layout/view_keypad_button" android:id="@+id/btn_6"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_5"
            app:layout_constraintTop_toBottomOf="@+id/btn_3" />

        <include layout="@layout/view_keypad_button" android:id="@+id/btn_7"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/btn_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_4" />

        <include layout="@layout/view_keypad_button" android:id="@+id/btn_8"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/btn_9"
            app:layout_constraintStart_toEndOf="@+id/btn_7"
            app:layout_constraintTop_toBottomOf="@+id/btn_5" />

        <include layout="@layout/view_keypad_button" android:id="@+id/btn_9"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_8"
            app:layout_constraintTop_toBottomOf="@+id/btn_6" />

        <include layout="@layout/view_keypad_button" android:id="@+id/btn_star"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/btn_0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_7" />

        <include layout="@layout/view_keypad_button" android:id="@+id/btn_0"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/btn_hash"
            app:layout_constraintStart_toEndOf="@+id/btn_star"
            app:layout_constraintTop_toBottomOf="@+id/btn_8" />

        <include layout="@layout/view_keypad_button" android:id="@+id/btn_hash"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_0"
            app:layout_constraintTop_toBottomOf="@+id/btn_9" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/actions_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btn_video"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_phone_24"
            android:padding="16dp"
            android:alpha="0.6"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <Space
            android:layout_width="48dp"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_call"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:icon="@drawable/ic_phone_24"
            app:iconGravity="textStart"
            app:iconSize="36dp"
            app:iconPadding="0dp"
            app:iconTint="@color/white"
            android:backgroundTint="@color/call_green"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <Space
            android:layout_width="48dp"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/btn_hide_keyboard"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_contacts_24"
            android:padding="16dp"
            android:alpha="0.6"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
