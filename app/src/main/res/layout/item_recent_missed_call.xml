<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemCallContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_call_item"
    android:elevation="5dp">

    <LinearLayout
        android:id="@+id/leftSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@id/rightSection"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name or Number"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FF0000" /> <TextView
        android:id="@+id/tvTitleDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Missed • Mobile"
        android:textSize="14sp"
        android:textColor="#7A7A7A"
        android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rightSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#111111" />
    </LinearLayout>
</RelativeLayout>